# Storefront <-> ERPNext (SERVER-ONLY — never expose these to the browser)
# Copy to .env.local and fill in once ERPNext is reachable.

# Use built-in mock catalog data (default). Set to "false" for a live ERPNext.
STOREFRONT_USE_MOCK=true

# Live ERPNext connection (required when STOREFRONT_USE_MOCK=false)
ERPNEXT_URL=https://erp.example.com
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Price lists (must match the names configured in ERPNext)
ERPNEXT_DEFAULT_PRICE_LIST=Retail
ERPNEXT_WHOLESALE_PRICE_LIST=Wholesale
